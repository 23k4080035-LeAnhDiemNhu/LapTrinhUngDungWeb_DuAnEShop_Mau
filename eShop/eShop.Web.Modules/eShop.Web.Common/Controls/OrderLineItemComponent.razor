@if (Order != null && Order.LineItems != null && Order.LineItems.Any())
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                @if (!IsReadOnly)
                {
                    <th>Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Order.LineItems)
            {
                <tr>
                    <td>
                        <NavLink href="@($"/product/{item.ProductId}")" class="fw-bold text-decoration-none">
                            @(item.Product?.Name ?? $"Product #{item.ProductId}")
                        </NavLink>
                    </td>
                    <td>@item.Price.ToString("c")</td>
                    <td>
                        @if (!IsReadOnly)
                        {
                            <input type="number" 
                                   min="1" 
                                   class="form-control form-control-sm w-50" 
                                   value="@item.Quantity" 
                                   @onchange="@((ChangeEventArgs e) => HandleQuantityChange(item, e))" />
                        }
                        else
                        {
                            @item.Quantity
                        }
                    </td>
                    <td class="fw-semibold">@((item.Price * item.Quantity).ToString("c"))</td>
                    @if (!IsReadOnly)
                    {
                        <td>
                            <button class="btn btn-outline-danger btn-sm" @onclick="@(() => HandleDelete(item))">
                                <span class="oi oi-trash"></span> Delete
                            </button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public Order Order { get; set; } = default!;

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    [Parameter]
    public EventCallback<OrderLineItem> OnQuantityChange { get; set; }

    [Parameter]
    public EventCallback<OrderLineItem> OnDeleteProduct { get; set; }

    private async Task HandleQuantityChange(OrderLineItem item, ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out int qty) && qty > 0)
        {
            item.Quantity = qty;
            if (OnQuantityChange.HasDelegate)
            {
                await OnQuantityChange.InvokeAsync(item);
            }
        }
    }

    private async Task HandleDelete(OrderLineItem item)
    {
        if (OnDeleteProduct.HasDelegate)
        {
            await OnDeleteProduct.InvokeAsync(item);
        }
    }
}
