@inject NavigationManager navigationManager

@if (targetOrder != null && targetOrder.LineItems != null)
{
    var totalItems = targetOrder.LineItems.Sum(x => x.Quantity);
    var totalPrice = targetOrder.LineItems.Sum(x => (x.Product != null ? x.Product.Price : x.Price) * x.Quantity);

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0">Order Summary</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <span>Total Items (@totalItems):</span>
                <span class="fw-bold">@totalPrice.ToString("c")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Shipping And Handling:</span>
                <span>$0.00</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Estimated Tax:</span>
                <span>$0.00</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between mb-3 fs-5 text-danger fw-bold">
                <span>Order Total:</span>
                <span>@totalPrice.ToString("c")</span>
            </div>
            @if (!HidePlaceOrder)
            {
                <button class="btn btn-success w-100 fw-bold" @onclick="PlaceOrder">
                    Proceed to Checkout
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Order? Order { get; set; }

    [Parameter]
    public Order? order { get; set; }

    [Parameter]
    public bool HidePlaceOrder { get; set; } = false;

    private Order? targetOrder => Order ?? order;

    private void PlaceOrder()
    {
        navigationManager.NavigateTo("/placeorder");
    }
}
