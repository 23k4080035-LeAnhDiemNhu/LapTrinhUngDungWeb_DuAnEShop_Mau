@page "/outstandingorders"
@attribute [Authorize]

@inject IViewOutstandingOrdersUseCase viewOutstandingOrdersUseCase
@inject IProcessOrderUseCase processOrderUseCase
@inject NavigationManager navigationManager

<h3>Outstanding Orders</h3>
<hr />

@if (outstandingOrders != null && outstandingOrders.Any())
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Date Placed</th>
                <th>Customer Name</th>
                <th>City / State</th>
                <th>Country</th>
                <th>Items</th>
                <th>Total</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in outstandingOrders)
            {
                var totalItems = order.LineItems?.Sum(x => x.Quantity) ?? 0;
                var totalAmount = order.LineItems?.Sum(x => x.Price * x.Quantity) ?? 0;

                <tr>
                    <td><strong>#@order.OrderId</strong></td>
                    <td>@(order.DatePlaced.HasValue ? order.DatePlaced.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "N/A")</td>
                    <td>@order.CustomerName</td>
                    <td>@order.CustomerCity, @order.CustomerStateProvince</td>
                    <td>@order.CustomerCountry</td>
                    <td><span class="badge bg-info text-dark">@totalItems</span></td>
                    <td class="fw-bold text-success">@totalAmount.ToString("c")</td>
                    <td class="text-center">
                        <button class="btn btn-primary btn-sm me-2" @onclick="@(() => HandleProcess(order.OrderId!.Value))">
                            <span class="oi oi-check"></span> Process
                        </button>
                        <NavLink href="@($"/orderdetail/{order.OrderId}")" class="btn btn-outline-secondary btn-sm">
                            <span class="oi oi-eye"></span> View Details
                        </NavLink>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-success">
        <span class="oi oi-circle-check"></span> There are currently no outstanding orders to process!
    </div>
}

@code {
    private IEnumerable<Order>? outstandingOrders;

    protected override void OnInitialized()
    {
        LoadOutstandingOrders();
    }

    private void LoadOutstandingOrders()
    {
        outstandingOrders = viewOutstandingOrdersUseCase.Execute();
    }

    private void HandleProcess(int orderId)
    {
        // For video 1 demo, default admin name is set to "Admin"
        bool success = processOrderUseCase.Execute(orderId, "Admin");
        if (success)
        {
            LoadOutstandingOrders();
        }
    }
}
