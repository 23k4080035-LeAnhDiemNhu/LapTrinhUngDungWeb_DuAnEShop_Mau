@page "/"
@rendermode InteractiveServer

<PageTitle>Trang Chủ - Blazor .NET 9 Studio</PageTitle>

<div class="mesh-bg position-relative py-3">
    <!-- Hero Section -->
    <div class="row align-items-center g-5 mb-5 py-4">
        <div class="col-lg-7">
            <!-- Pill Status Badge -->
            <div class="mb-3">
                <span class="pill-badge pill-purple">
                    <span class="pulse-dot text-purple"></span>
                    .NET 9 Blazor Interactive Server Framework
                </span>
            </div>

            <!-- Title Header -->
            <h1 class="display-4 fw-extrabold text-light mb-3" style="letter-spacing: -0.03em; line-height: 1.15;">
                Xây Dựng Web Application <br />
                <span class="gradient-text-primary">Đỉnh Cao Với Blazor .NET 9</span>
            </h1>

            <p class="lead text-secondary mb-4" style="font-size: 1.15rem; max-width: 600px; line-height: 1.6;">
                Nền tảng phát triển ứng dụng Web thời gian thực thế hệ mới. Kết hợp sức mạnh của <strong>C# 13</strong>, kết nối <strong>WebSocket SignalR</strong> siêu tốc và giao diện <strong>Glassmorphism Modern UI</strong>.
            </p>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <a href="counter" class="btn-hero-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zM4.5 7.5a.5.5 0 0 0 0 1h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H4.5z"/>
                    </svg>
                    <span>Khám Phá Counter Demo</span>
                </a>

                <a href="weather" class="btn-hero-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 16a6 6 0 0 0 6-6c0-1.865-1.002-3.568-2.6-4.5.3-1.05.08-2.22-.65-3.05a3.5 3.5 0 0 0-4.95 0c-.73.83-.95 2-.65 3.05C3.552 6.432 2.55 8.135 2.55 10a6 6 0 0 0 5.45 6Z"/>
                    </svg>
                    <span>Dự Báo Thời Tiết</span>
                </a>
            </div>

            <!-- Key Metric Highlights -->
            <div class="row g-4 mt-4 pt-3 border-top border-secondary border-opacity-25">
                <div class="col-4">
                    <div class="h3 fw-bold gradient-text-cyan mb-0">~5ms</div>
                    <small class="text-secondary" style="font-size: 0.8rem;">Độ trễ SignalR</small>
                </div>
                <div class="col-4">
                    <div class="h3 fw-bold gradient-text-primary mb-0">100% C#</div>
                    <small class="text-secondary" style="font-size: 0.8rem;">Không cần JavaScript</small>
                </div>
                <div class="col-4">
                    <div class="h3 fw-bold gradient-text-gold mb-0">.NET 9</div>
                    <small class="text-secondary" style="font-size: 0.8rem;">Phiên bản mới nhất</small>
                </div>
            </div>
        </div>

        <!-- Interactive Hero Code / Preview Component Card -->
        <div class="col-lg-5">
            <div class="code-window">
                <div class="code-header">
                    <div class="d-flex gap-2">
                        <span class="dot dot-red"></span>
                        <span class="dot dot-yellow"></span>
                        <span class="dot dot-green"></span>
                    </div>
                    <span class="text-secondary font-monospace" style="font-size: 0.75rem;">InteractiveStudio.razor</span>
                </div>
                <div class="p-4" style="background: rgba(15, 23, 42, 0.95);">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="pill-badge pill-emerald">Live Server SignalR</span>
                        <span class="text-secondary small font-monospace">State: Active</span>
                    </div>

                    <!-- Mini Live Interactive Component Box -->
                    <div class="card-glass p-3 mb-3 text-center" style="background: rgba(30, 41, 59, 0.6);">
                        <small class="text-uppercase text-secondary fw-semibold" style="font-size: 0.75rem;">Interactive Live Test</small>
                        <div class="display-5 fw-bold gradient-text-primary my-2">@homeCounter</div>
                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <button class="btn btn-sm btn-hero-primary py-1 px-3" @onclick="IncrementHomeCounter">+ Thử Tăng</button>
                            <button class="btn btn-sm btn-hero-secondary py-1 px-3" @onclick="ResetHomeCounter">Reset</button>
                        </div>
                    </div>

                    <pre class="mb-0 text-light font-monospace" style="font-size: 0.8rem; line-height: 1.5; color: #a5b4fc;"><code style="color: #818cf8;">@@page</code> <span style="color: #f472b6;">"/"</span>
<code style="color: #818cf8;">@@rendermode</code> <span style="color: #34d399;">InteractiveServer</span>

<span style="color: #94a3b8;">&lt;!-- Blazor C# Component --&gt;</span>
<span style="color: #38bdf8;">&lt;h2&gt;</span>Value: @@homeCounter<span style="color: #38bdf8;">&lt;/h2&gt;</span>
<span style="color: #38bdf8;">&lt;button</span> <code style="color: #fbbf24;">@@onclick</code>=<span style="color: #f472b6;">"Increment"</span><span style="color: #38bdf8;">&gt;</span>Click Me<span style="color: #38bdf8;">&lt;/button&gt;</span></pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Grid Section -->
    <div class="mt-5">
        <div class="text-center mb-5" style="max-width: 600px; margin: 0 auto;">
            <span class="pill-badge pill-cyan mb-2">Đặc Tính Nổi Bật</span>
            <h2 class="fw-bold text-light">Tại Sao Chọn Blazor .NET 9?</h2>
            <p class="text-secondary">Công nghệ lập trình Web full-stack mạnh mẽ cho phép triển khai dự án nhanh chóng và tin cậy.</p>
        </div>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-glass p-4 h-100">
                    <div class="icon-box-gradient icon-purple">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09Z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-light mb-2">SignalR Realtime</h5>
                    <p class="text-secondary small mb-0">Cập nhật DOM siêu tốc từ C# backend thông qua kết nối WebSocket tự động duy trì.</p>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-glass p-4 h-100">
                    <div class="icon-box-gradient icon-cyan">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.5 2A3.5 3.5 0 0 0 2 5.5v5A3.5 3.5 0 0 0 5.5 14h5a3.5 3.5 0 0 0 3.5-3.5v-5A3.5 3.5 0 0 0 10.5 2h-5zM8 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-light mb-2">Dark Glass Design</h5>
                    <p class="text-secondary small mb-0">Giao diện màu tối mờ ảo Glassmorphism hiện đại chuẩn xu hướng thiết kế 2026.</p>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-glass p-4 h-100">
                    <div class="icon-box-gradient icon-rose">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-light mb-2">Bảo Mật Cao</h5>
                    <p class="text-secondary small mb-0">Toàn bộ logic nghiệp vụ thực thi an toàn trên Server mà không lộ mã nguồn frontend.</p>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-glass p-4 h-100">
                    <div class="icon-box-gradient icon-emerald">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-light mb-2">SEO Optimized</h5>
                    <p class="text-secondary small mb-0">Hỗ trợ Static Server Rendering (SSR) ban đầu cho phép Google bot crawl dữ liệu hoàn hảo.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int homeCounter = 42;

    private void IncrementHomeCounter()
    {
        homeCounter++;
    }

    private void ResetHomeCounter()
    {
        homeCounter = 0;
    }
}
